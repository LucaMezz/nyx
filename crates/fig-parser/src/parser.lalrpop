use crate::LexicalError;
use crate::ast::*;
use crate::parse_interp_parts;
use fig_lexer::{Token, FloatLiteral, IntegerLiteral};
use lalrpop_util::ErrorRecovery;

grammar<'err>(errors: &'err mut Vec<ErrorRecovery<usize, Token, LexicalError>>);

// ============================================================================
// Main Entry Point
// ============================================================================

pub SourceFile: SourceFile = {
    <items: SourceFileItem*> => SourceFile::new(items)
};

/// Top-level items — dispatched to focused sub-rules grouped by kind.
/// The shared DeclHead prefix (visibility? + annotations) is parsed once inside
/// each sub-rule so the LALR automaton still only tracks it once per alternative.
SourceFileItem: NamespaceItem = {
    SourceFileItemNamespace,
    SourceFileItemFunction,
    SourceFileItemTypeAlias,
    SourceFileItemDataType,
    SourceFileItemConst,
    SourceFileItemUsing,
    // Error recovery: skip tokens up to the next top-level item boundary.
    ! => { errors.push(<>); NamespaceItem::Error },
};

// ── Namespace items ──────────────────────────────────────────────────────────

/// `namespace Name { … }` or bare `namespace Name` (forward declaration)
SourceFileItemNamespace: NamespaceItem = {
    <h: DeclHead> "namespace" <name: Path> "NEWLINE" "INDENT" <items: Statement*> "DEDENT"
        => { let (v, a) = h; NamespaceItem::Namespace(Namespace { visibility: v.unwrap_or_default(), annotations: a, name, items }) },
    <h: DeclHead> "namespace" <name: Path> "NEWLINE"
        => { let (v, a) = h; NamespaceItem::NamespaceDeclaration(NamespaceDeclaration { visibility: v.unwrap_or_default(), annotations: a, name }) },
};

// ── Function items ───────────────────────────────────────────────────────────

/// `func …` definition (with body) or forward declaration (no body)
SourceFileItemFunction: NamespaceItem = {
    <h: DeclHead> <sig: FunctionSignatureBase> "NEWLINE" "INDENT" <wc: WhereClause?> <body: Block> "DEDENT"
        => { let (v, a) = h; let sig = FunctionSignature { visibility: v.unwrap_or_default(), annotations: a, outer_generic_params: merge_where_clause(sig.outer_generic_params, wc.unwrap_or_default()), ..sig }; NamespaceItem::Function(Function { signature: sig, body }) },
    <h: DeclHead> <sig: FunctionSignatureBase> "NEWLINE"
        => { let (v, a) = h; let sig = FunctionSignature { visibility: v.unwrap_or_default(), annotations: a, ..sig }; NamespaceItem::FunctionDeclaration(FunctionDeclaration { signature: sig }) },
};

// ── Type alias items ─────────────────────────────────────────────────────────

/// `type Name[T] = Type` (inline) or with a where clause in an indented block
SourceFileItemTypeAlias: NamespaceItem = {
    <h: DeclHead> "type" <path: Path> <gp: GenericParameterList?> "=" <ty: TopLevelType> "NEWLINE"
        => { let (v, a) = h; NamespaceItem::TypeAlias(TypeAlias { visibility: v.unwrap_or_default(), annotations: a, name: path, generic_params: gp.unwrap_or_default(), aliased_type: ty }) },
    <h: DeclHead> "type" <path: Path> <gp: GenericParameterList?> "NEWLINE" "INDENT" <wc: WhereClause> "=" <ty: TopLevelType> "DEDENT"
        => { let (v, a) = h; NamespaceItem::TypeAlias(TypeAlias { visibility: v.unwrap_or_default(), annotations: a, name: path, generic_params: merge_where_clause(gp.unwrap_or_default(), wc), aliased_type: ty }) },
};

// ── Nominal data-type items ──────────────────────────────────────────────────

/// `enum`, `union`, `struct`, and `interface` declarations
SourceFileItemDataType: NamespaceItem = {
    <h: DeclHead> <e: EnumTail>
        => { let (v, a) = h; NamespaceItem::Enum(Enum { visibility: v.unwrap_or_default(), annotations: a, ..e }) },
    <h: DeclHead> <u: UnionTail>
        => { let (v, a) = h; NamespaceItem::Union(Union { visibility: v.unwrap_or_default(), annotations: a, ..u }) },
    <h: DeclHead> <s: StructTail>
        => { let (v, a) = h; NamespaceItem::Struct(Struct { visibility: v.unwrap_or_default(), annotations: a, ..s }) },
    <h: DeclHead> <i: InterfaceTail>
        => { let (v, a) = h; NamespaceItem::Interface(Interface { visibility: v.unwrap_or_default(), annotations: a, ..i }) },
};

// ── Constant items ───────────────────────────────────────────────────────────

/// `const` declaration with a fully-qualified name.
///
/// Full form: `const[T, U] namespacea::namespaceb::Option[T]::SOME_CONSTANT: i32 = 10`
///   - `[T, U]`           — universally-quantified generic parameters (optional)
///   - receiver segments  — zero or more `SegmentName[GenericArgs]::` before the final name
///   - `SOME_CONSTANT`    — the actual constant name (plain ident)
///   - `: i32`            — type annotation (optional, can be inferred)
SourceFileItemConst: NamespaceItem = {
    <h: DeclHead> "const" <cn: ConstNamePath> <ty: (":" <Type>)?> "=" <val: Expression> "NEWLINE"
        => {
            let (v, a) = h;
            let (gp, recv, name) = cn;
            NamespaceItem::Const(ConstStatement { visibility: v.unwrap_or_default(), annotations: a, generic_params: gp, receiver: recv, name, ty, value: Box::new(val) })
        },
};

// ── Using items ──────────────────────────────────────────────────────────────

/// `using path`
SourceFileItemUsing: NamespaceItem = {
    <h: DeclHead> "using" <path: Path> "NEWLINE"
        => { let (v, a) = h; NamespaceItem::Using(UsingStatement { visibility: v.unwrap_or_default(), annotations: a, path }) },
};

// ── Const Name Path ──────────────────────────────────────────────────────────

/// One receiver-path segment with its optional generic arguments, e.g. `Option[T]` or `namespacea`.
ConstPathSeg: ConstPathSegment = {
    <name: PathSegment> <ga: GenericArgumentList?> => ConstPathSegment { name, generic_args: ga.unwrap_or_default() },
};

/// Parses the full name portion of a `const` declaration:
///
///   `const[T, U] namespacea::namespaceb::Option[T]::SOME_CONSTANT`
///
///   Returns `(generic_params, receiver_segments, final_name)`.
///
///   - `generic_params`     — the `[T, U]` after `const`, empty if absent
///   - `receiver_segments`  — zero or more `Seg[args]::` segments before the name
///   - `final_name`         — the plain ident at the end
///
/// LALR(1) disambiguation:
///   After `PathSegment` in the inline `(ConstPathSeg "::")*`, the lookahead is unambiguous:
///     `::` or `[`  → this ident is a receiver segment, continue the star
///     `:` or `=`   → this ident is the final name, exit the star
ConstNamePath: (Vec<GenericParameter>, Vec<ConstPathSegment>, String) = {
    <gp: GenericParameterList?> <segs: (<ConstPathSeg> "::")*> <name: "ident">
        => (gp.unwrap_or_default(), segs, name),
};

// ============================================================================
// Shared Declaration Header  (factored out to avoid state explosion)
// ============================================================================

/// Parses the optional visibility modifier and zero-or-more annotations that
/// precede every declaration.  By factoring this into a single rule, the LALR
/// automaton tracks these items ONCE instead of N times (once per declaration
/// alternative).
DeclHead: (Option<Visibility>, Vec<Annotation>) = {
    <a: Annotations> <v: Visibility?> => (v, a)
};

Visibility: Visibility = {
    "public"  => Visibility::Public,
    "export"  => Visibility::Export,
    "private" => Visibility::Private,
};

Annotation: Annotation = {
    "#" <name: "ident"> => Annotation { name, args: vec![] },
    "#" <name: "ident"> "(" <args: Comma<Expression>> ")" => Annotation { name, args },
};

/// Zero or more annotations, each followed by a NEWLINE
Annotations: Vec<Annotation> = {
    (<Annotation> "NEWLINE")* => <>,
};

// ============================================================================
// Expressions  (precedence levels 1 - 12)
// ============================================================================

Expression: Expression = {
    // Cast: `expr as Type` — level 12, tighter than all binary operators so
    // `x as T + y` parses as `(x as T) + y` and `x as T == y` as `(x as T) == y`.
    #[precedence(level="12")] #[assoc(side="left")]
    <expr: Expression> "as" <ty: Type>
        => Expression::Cast(CastExpr { expr: Box::new(expr), target_type: Box::new(ty) }),

    #[precedence(level="11")] #[assoc(side="left")]
    <lhs: Expression> "*" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::Multiply, rhs: Box::new(rhs) }),
    <lhs: Expression> "/" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::Divide, rhs: Box::new(rhs) }),
    <lhs: Expression> "%" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::Modulo, rhs: Box::new(rhs) }),

    #[precedence(level="10")] #[assoc(side="left")]
    <lhs: Expression> "+" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::Add, rhs: Box::new(rhs) }),
    <lhs: Expression> "-" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::Subtract, rhs: Box::new(rhs) }),

    #[precedence(level="9")] #[assoc(side="left")]
    <lhs: Expression> "<<" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::ShiftLeft, rhs: Box::new(rhs) }),
    <lhs: Expression> ">>" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::ShiftRight, rhs: Box::new(rhs) }),

    #[precedence(level="8")] #[assoc(side="left")]
    <lhs: Expression> "<" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::LessThan, rhs: Box::new(rhs) }),
    <lhs: Expression> ">" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::GreaterThan, rhs: Box::new(rhs) }),
    <lhs: Expression> "<=" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::LessThanOrEqual, rhs: Box::new(rhs) }),
    <lhs: Expression> ">=" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::GreaterThanOrEqual, rhs: Box::new(rhs) }),

    #[precedence(level="7")] #[assoc(side="left")]
    <lhs: Expression> "==" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::Equal, rhs: Box::new(rhs) }),
    <lhs: Expression> "!=" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::NotEqual, rhs: Box::new(rhs) }),

    #[precedence(level="6")] #[assoc(side="left")]
    <lhs: Expression> "&" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::BitwiseAnd, rhs: Box::new(rhs) }),

    #[precedence(level="5")] #[assoc(side="left")]
    <lhs: Expression> "^" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::BitwiseXor, rhs: Box::new(rhs) }),

    #[precedence(level="4")] #[assoc(side="left")]
    <lhs: Expression> "|" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::BitwiseOr, rhs: Box::new(rhs) }),

    #[precedence(level="3")] #[assoc(side="left")]
    <lhs: Expression> "&&" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::LogicalAnd, rhs: Box::new(rhs) }),

    #[precedence(level="2")] #[assoc(side="left")]
    <lhs: Expression> "||" <rhs: Expression>
        => Expression::BinaryOp(BinaryOpExpr { lhs: Box::new(lhs), op: BinaryOperator::LogicalOr, rhs: Box::new(rhs) }),

    #[precedence(level="1")]
    PostfixExpr,
};

/// Handles all postfix operators with explicit left-recursion.
/// Precedence note: `Unary` handles prefix operators and bottoms out at `Atom`.
/// `PostfixExpr` wraps `Unary` so postfix binds LESS tightly than prefix, i.e.
/// `-p.x` == `(-p).x` (same behaviour as the previous grammar).
PostfixExpr: Expression = {
    // Propagating field access: obj.!field
    <obj: PostfixExpr> "." "!" <field: "ident">
        => Expression::FieldAccess(FieldAccessExpr { object: Box::new(obj), field, is_propagating: true }),
    // Propagating method call: obj.method!(args)  — e.g. `v.push!(42)`
    // The `!` sits AFTER the field name, just before `(`.
    // Shift/reduce on `!` after `PostfixExpr "." ident`: resolved by shift (default).
    <obj: PostfixExpr> "." <field: "ident"> "!" "(" <args: Comma<CallArgument>> ")"
        => {
            let callee = Expression::FieldAccess(FieldAccessExpr {
                object: Box::new(obj), field, is_propagating: false,
            });
            Expression::Call(CallExpr { callee: Box::new(callee), args, generic_args: None, is_propagating: true })
        },
    // Multi-line propagating method call: obj.method!(\nINDENT\narg1,\narg2\nDEDENT)
    <obj: PostfixExpr> "." <field: "ident"> "!" "(" "NEWLINE" "INDENT" <args: MultilineCallArgs> "DEDENT" ")"
        => {
            let callee = Expression::FieldAccess(FieldAccessExpr {
                object: Box::new(obj), field, is_propagating: false,
            });
            Expression::Call(CallExpr { callee: Box::new(callee), args, generic_args: None, is_propagating: true })
        },
    // Regular field access: obj.field
    <obj: PostfixExpr> "." <field: "ident">
        => Expression::FieldAccess(FieldAccessExpr { object: Box::new(obj), field, is_propagating: false }),
    // Type access: obj::member
    <obj: PostfixExpr> "::" <member: "ident">
        => Expression::TypeAccess(TypeAccessExpr { object: Box::new(obj), member }),
    // Regular call: callee(args)
    <callee: PostfixExpr> "(" <args: Comma<CallArgument>> ")"
        => Expression::Call(CallExpr { callee: Box::new(callee), args, generic_args: None, is_propagating: false }),
    // Multi-line call: callee(\nINDENT\narg1,\narg2\nDEDENT)
    <callee: PostfixExpr> "(" "NEWLINE" "INDENT" <args: MultilineCallArgs> "DEDENT" ")"
        => Expression::Call(CallExpr { callee: Box::new(callee), args, generic_args: None, is_propagating: false }),
    // Generic call via turbofish: callee::[GenericArgs](args)
    <callee: PostfixExpr> "::" <gp: GenericArgumentList> "(" <args: Comma<CallArgument>> ")"
        => Expression::Call(CallExpr { callee: Box::new(callee), args, generic_args: Some(gp), is_propagating: false }),
    // Multi-line generic call via turbofish: callee::[GenericArgs](\nINDENT\narg1,\nDEDENT)
    <callee: PostfixExpr> "::" <gp: GenericArgumentList> "(" "NEWLINE" "INDENT" <args: MultilineCallArgs> "DEDENT" ")"
        => Expression::Call(CallExpr { callee: Box::new(callee), args, generic_args: Some(gp), is_propagating: false }),
    // Generic instantiation in expression position: obj[T...]
    // ExprGenericArgList only matches cases that are unambiguous with the Index rule
    // (primitive type keywords, nullable types, pointer-to-primitive, multi-arg with comma).
    <obj: PostfixExpr> <ga: ExprGenericArgList>
        => Expression::GenericInstantiation(Box::new(obj), ga),
    // Index: obj[idx]
    <obj: PostfixExpr> "[" <idx: Expression> "]"
        => Expression::Index(IndexExpr { object: Box::new(obj), index: Box::new(idx) }),
    // Base case: prefix-unary and atoms
    Unary,
};

/// A generic-argument list in expression position whose content is
/// unambiguous with the index-expression rule `obj[idx]`.
///
/// The ambiguity arises when a single identifier appears inside the brackets:
/// `obj[T]` could be an index (T = expression) or generic instantiation
/// (T = type).  We resolve it by only covering cases where the bracket content
/// **cannot** be parsed as an expression:
///
///  * Multiple arguments separated by commas — `,` is not in FOLLOW(Expression)
///    inside `obj[expr]`, so LALR(1) always forces the first token to start a Type.
///  * A single primitive-type keyword (`i32`, `u8`, `usize`, …) — these tokens
///    are not valid expression starts.
///  * A single nullable type `?T` — `?` cannot start an expression.
///  * A single pointer-to-primitive `*mut? PrimType` — the primitive keyword
///    disambiguates the inner position.
///  * A single nested-slice type `[[T]]` where the inner element is a PrimType.
// Primitive types that can appear inside ExprGenericArgList without causing
// a reduce-reduce conflict with expression atoms.  "null" is excluded because
// it also appears as Expression::NullLiteral in Atom, making it ambiguous.
ExprPrimType: Type = {
    "u8"    => Type::U8,
    "u16"   => Type::U16,
    "u32"   => Type::U32,
    "u64"   => Type::U64,
    "usize" => Type::USize,
    "i8"    => Type::I8,
    "i16"   => Type::I16,
    "i32"   => Type::I32,
    "i64"   => Type::I64,
    "isize" => Type::ISize,
    "f32"   => Type::F32,
    "f64"   => Type::F64,
    "bool"  => Type::Bool,
    // Note: "null" deliberately omitted — it's also Expression::NullLiteral
};

// Generic type argument for use inside ExprGenericArgList only.
// Deliberately restricted to NON-ident-starting alternatives so that
// after `PostfixExpr "["` the parser can unambiguously choose between
// GenericTypeArg (type-arg) and Expression (index expression).
// ident-starting paths are NOT included here because they share the same
// LR(1) predecessor state as expression idents, causing irresolvable conflicts.
GenericTypeArg: Type = {
    ExprPrimType,
    // Nullable: ?T
    "?" <inner: GenericTypeArg>
        => Type::Nullable(Box::new(inner)),
    // Pointer: *T or *mut T (only with non-ident inner type to stay unambiguous)
    "*" "mut" <inner: GenericTypeArg>
        => Type::Pointer { nullable: false, mutable: true,  element_type: Box::new(inner) },
    "*" <inner: GenericTypeArg>
        => Type::Pointer { nullable: false, mutable: false, element_type: Box::new(inner) },
    // Slice: [T]
    "[" <elem: GenericTypeArg> "]"
        => Type::Array { element_type: Box::new(elem), size: None },
};

ExprGenericArgList: Vec<Type> = {
    // ── Two or more type args (comma after first is unambiguous with Index) ───
    // e.g. HashMap[K, V],  BPlusTree[K, V]
    "[" <first: GenericTypeArg> "," <rest: Comma<GenericTypeArg>> "]"
        => { let mut v = vec![first]; v.extend(rest); v },

    // ── Single primitive-type keyword (unambiguous: primitives aren't exprs) ──
    // e.g. Seq[i32],  Future[usize],  SerdeResult[u8]
    "[" <ty: ExprPrimType> "]" => vec![ty],

    // ── Single nullable type (`?` cannot start an expression) ────────────────
    // e.g. Opt[?T]
    "[" "?" <inner: GenericTypeArg> "]" => vec![Type::Nullable(Box::new(inner))],

    // ── Single pointer-to-primitive (`*u8`, `*mut i32`, …) ──────────────────
    "[" "*" <mutable: "mut"?> <prim: ExprPrimType> "]"
        => vec![Type::Pointer { nullable: false, mutable: mutable.is_some(),
                                element_type: Box::new(prim) }],

    // ── Single nested slice (`[[u8]]`): `[[` can't start an index expression ─
    "[" "[" <elem: GenericTypeArg> "]" "]"
        => vec![Type::Array { element_type: Box::new(elem), size: None }],
};

Unary: Expression = {
    "!" <operand: Unary>
        => Expression::UnaryOp(UnaryOpExpr { op: UnaryOperator::LogicalNot, operand: Box::new(operand) }),
    "~" <operand: Unary>
        => Expression::UnaryOp(UnaryOpExpr { op: UnaryOperator::BitwiseNot, operand: Box::new(operand) }),
    "-" <operand: Unary>
        => Expression::UnaryOp(UnaryOpExpr { op: UnaryOperator::Negate, operand: Box::new(operand) }),
    "+" <operand: Unary>
        => Expression::UnaryOp(UnaryOpExpr { op: UnaryOperator::Plus, operand: Box::new(operand) }),
    "&" <operand: Unary>
        => Expression::UnaryOp(UnaryOpExpr { op: UnaryOperator::AddressOf, operand: Box::new(operand) }),
    "*" <operand: Unary>
        => Expression::UnaryOp(UnaryOpExpr { op: UnaryOperator::Dereference, operand: Box::new(operand) }),
    Atom,
};

Atom: Expression = {
    <lit: "int">    => Expression::IntegerLiteral(lit),
    <lit: "float">  => Expression::FloatLiteral(lit),
    "true"          => Expression::BooleanLiteral(true),
    "false"         => Expression::BooleanLiteral(false),
    <lit: "char">   => Expression::CharLiteral(lit),
    <lit: "string"> => Expression::StringLiteral(lit),
    <raw: "interpstring"> => Expression::InterpolatedString(parse_interp_parts(raw)),
    "null"          => Expression::NullLiteral,
    "self"          => Expression::SelfValue,
    "sizeof" "(" <ty: Type> ")"  => Expression::Sizeof(Box::new(ty)),
    "alignof" "(" <ty: Type> ")" => Expression::Alignof(Box::new(ty)),
    "offsetof" "(" <ty: Type> "," <field: "ident"> ")"
        => Expression::Offsetof(OffsetofExpr { ty: Box::new(ty), field }),
    <last: PathSegment> => Expression::Path(Path { segments: vec![last] }),
    "[" <elements: Comma<Expression>> "]"
        => Expression::ArrayLiteral(ArrayLiteralExpr { elements }),
    "[" <value: Expression> ";" <count: Expression> "]"
        => Expression::RepeatArrayLiteral(RepeatArrayExpr { value: Box::new(value), count: Box::new(count) }),
    "(" <expr: Expression> ")" => Expression::Parenthesized(Box::new(expr)),
};

// ============================================================================
// Call arguments
// ============================================================================

/// A single argument in a call expression.
/// Named form:      `name: value`   — used for struct construction and keyword args.
/// Positional form: `value`         — a plain expression.
///
/// LALR(1) disambiguation: after an `ident`, if the lookahead is `:` (Token::Colon)
/// the parser shifts into the named-argument alternative.  Any other lookahead causes
/// the `ident` to be reduced through the normal expression chain as a positional arg.
/// This works without conflict because `:` never appears in the follow set of
/// `Expression` inside a call argument list (`,` and `)` do, but not `:`).
CallArgument: CallArgument = {
    <name: "ident"> ":" <value: Expression> => CallArgument { name: Some(name), value },
    <value: Expression>                     => CallArgument { name: None,        value },
};

/// Arguments for a multi-line call expression (written with each arg on its own
/// indented line).  Token layout inside the call's INDENT…DEDENT block:
///
///   arg1, NEWLINE
///   arg2, NEWLINE
///   …
///   lastArg NEWLINE       ← trailing comma optional on every line
///
/// Uses right-recursion so the LALR(1) lookahead cleanly distinguishes
/// between "more args coming" (expression-start token → shift) and
/// "this is the last arg" (DEDENT → reduce).
MultilineCallArgs: Vec<CallArgument> = {
    // arg with trailing comma, followed by more args
    <arg: CallArgument> "," "NEWLINE" <rest: MultilineCallArgs>
        => { let mut v = vec![arg]; v.extend(rest); v },
    // last arg with trailing comma (lookahead: DEDENT)
    <arg: CallArgument> "," "NEWLINE"
        => vec![arg],
    // last arg without trailing comma (lookahead: DEDENT)
    <arg: CallArgument> "NEWLINE"
        => vec![arg],
};



PathSegment: String = {
    <s: "ident">  => s,
};

Path: Path = {
    <segments: (<PathSegment> "::")* > <last: PathSegment>
        => {
            let mut s = segments;
            s.push(last);
            Path { segments: s }
        },
};

// ============================================================================
// Generic Parsing
// ============================================================================

GenericArgumentList: Vec<Type> = {
    "[" <args: Comma<Type>> "]" => args,
};

GenericParameterList: Vec<GenericParameter> = {
    "[" <params: Comma<GenericParameter>> "]" => params,
};

GenericParameter: GenericParameter = {
    BoundedTypeParameter,
    TypeParameterWithDefault,
    TypeParameter,
    ConstParameter,
};

ConstParameter: GenericParameter = {
    "const" <name: "ident"> ":" <ty: Type>
        => GenericParameter::Const { name, ty },
};

TypeParameter: GenericParameter = {
    <name: "ident">
        => GenericParameter::Type { name, bounds: vec![], default_type: None },
};

BoundedTypeParameter: GenericParameter = {
    <name: "ident"> ":" <bounds: TypeBounds>
        => GenericParameter::Type { name, bounds, default_type: None },
};

TypeParameterWithDefault: GenericParameter = {
    <name: "ident"> "=" <ty: Type>
        => GenericParameter::Type { name, bounds: vec![], default_type: Some(Box::new(ty)) },
};

TypeBounds: Vec<Type> = {
    <first: TypeBound> => vec![first],
    <mut v: TypeBounds> "+" <last: TypeBound> => { v.push(last); v },
};

/// A single bound — no error-union `T ! E` (keeps `!` out of follow(TypeBound)).
TypeBound: Type = {
    NullableType,
};

// ============================================================================
// Type Parsing
// ============================================================================

/// General type rule — does NOT include error-union `T ! E`.
/// This keeps `!` out of the general follow-set and avoids LR(1) conflicts.
Type: Type = {
    "?" <inner: Type>
        => Type::Nullable(Box::new(inner)),
    PointerType,
};

/// Top-level type that allows error-union `T ! E`.  Only used in positions
/// where `!` cannot appear in the follow set (function return types, type-alias
/// targets), so the shift/reduce conflict with unary `!` never arises.
TopLevelType: Type = {
    <ok: Type> "!" <err: Type>
        => Type::ErrorUnion { ok_type: Box::new(ok), err_type: Box::new(err) },
    Type,
};

NullableType: Type = {
    "?" <inner: Type>
        => Type::Nullable(Box::new(inner)),
    PointerType,
};

PointerType: Type = {
    "*" <mutable: "mut"?> <inner: Type>
        => Type::Pointer {
            nullable: false,
            mutable: mutable.is_some(),
            element_type: Box::new(inner),
        },
    SliceArrayType,
};

SliceArrayType: Type = {
    "[" <elem: Type> ";" <size: Expression> "]"
        => Type::Array { element_type: Box::new(elem), size: Some(Box::new(size)) },
    "[" <elem: Type> "]"
        => Type::Array { element_type: Box::new(elem), size: None },
    FunctionType,
    PrimitiveType,
    NamedType,
};

/// Function type: `func(T1, T2) -> R`.
/// The `->` return-type annotation is optional; if absent, `return_type` is `None`.
/// Uses `Type` (not `TopLevelType`) for the return to avoid a shift-reduce
/// conflict on `!` when the function type appears inside a pointer or nullable
/// type context (e.g. `*func(T) -> ok ! Err` is written as a type alias instead).
FunctionType: Type = {
    "func" "(" <params: Comma<Type>> ")" "->" <ret: Type>
        => Type::Function { param_types: params, return_type: Some(Box::new(ret)) },
    "func" "(" <params: Comma<Type>> ")"
        => Type::Function { param_types: params, return_type: None },
};

NamedType: Type = {
    <path: Path> <ga: GenericArgumentList?> => Type::Path { path, generic_args: ga.unwrap_or_default() },
};

PrimitiveType: Type = {
    "u8"    => Type::U8,
    "u16"   => Type::U16,
    "u32"   => Type::U32,
    "u64"   => Type::U64,
    "usize" => Type::USize,
    "i8"    => Type::I8,
    "i16"   => Type::I16,
    "i32"   => Type::I32,
    "i64"   => Type::I64,
    "isize" => Type::ISize,
    "f32"   => Type::F32,
    "f64"   => Type::F64,
    "bool"  => Type::Bool,
    "null"  => Type::Null,
};

// ============================================================================
// Clause Parsing
// ============================================================================

WhereClause: Vec<GenericParameter> = {
    "where" "NEWLINE" "INDENT" <constraints: TypeConstraint+> "DEDENT" => constraints,
};

TypeConstraint: GenericParameter = {
    <name: "ident"> ":" <bounds: TypeBounds> "NEWLINE"
        => GenericParameter::Type { name, bounds, default_type: None },
};

RequiresClause: Vec<Type> = {
    "requires" "NEWLINE" "INDENT" <types: (<Type> "NEWLINE")+> "DEDENT" => types,
};

ExtendsClause: Vec<Type> = {
    "extends" "NEWLINE" "INDENT" <types: (<Type> "NEWLINE")+> "DEDENT" => types,
};

// ============================================================================
// Statements
// ============================================================================

Statement: Statement = {
    // ── Simple (no DeclHead prefix) ─────────────────────────────────────────
    "pass" "NEWLINE"
        => Statement::Pass,
    // ── Assignment (prevented from nesting by being statement-only) ─────────
    <lhs: Expression> "="   <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::Assign,       rhs: Box::new(rhs) }))),
    <lhs: Expression> "+="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::AddAssign,    rhs: Box::new(rhs) }))),
    <lhs: Expression> "-="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::SubAssign,    rhs: Box::new(rhs) }))),
    <lhs: Expression> "*="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::MulAssign,    rhs: Box::new(rhs) }))),
    <lhs: Expression> "/="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::DivAssign,    rhs: Box::new(rhs) }))),
    <lhs: Expression> "%="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::ModAssign,    rhs: Box::new(rhs) }))),
    <lhs: Expression> "&="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::BitAndAssign, rhs: Box::new(rhs) }))),
    <lhs: Expression> "|="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::BitOrAssign,  rhs: Box::new(rhs) }))),
    <lhs: Expression> "^="  <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::BitXorAssign, rhs: Box::new(rhs) }))),
    <lhs: Expression> "<<=" <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::ShlAssign,    rhs: Box::new(rhs) }))),
    <lhs: Expression> ">>=" <rhs: Expression> "NEWLINE"
        => Statement::Expression(Box::new(Expression::Assign(AssignExpr { lhs: Box::new(lhs), op: AssignOperator::ShrAssign,    rhs: Box::new(rhs) }))),
    <e: Expression> "NEWLINE"
        => Statement::Expression(Box::new(e)),
    "return" <val: Expression> "NEWLINE"
        => Statement::Return(Box::new(val)),
    "break" "NEWLINE"
        => Statement::Break,
    "continue" "NEWLINE"
        => Statement::Continue,
    <s: IfStatement>    => Statement::If(s),
    <s: ForStatement>   => Statement::For(s),
    <s: WhileStatement> => Statement::While(s),
    <s: BlockStatement> => Statement::Block(s),
    // ── Declarations (all share a single DeclHead prefix) ───────────────────
    <d: Declaration>    => d,
};

/// All declaration-style statements share the DeclHead prefix (Visibility? +
/// Annotations).  By routing them through this single rule, the LALR automaton
/// avoids duplicating those item sets for every declaration type.
Declaration: Statement = {
    // let / mut with assignment (only use annotations, no visibility — we accept v silently)
    <h: DeclHead> "let" <name: "ident"> <ty: (":" <Type>)?> "=" <val: Expression> "NEWLINE"
        => { let (_, a) = h; Statement::Let(LetStatement { annotations: a, name, ty, value: Box::new(val) }) },
    <h: DeclHead> "mut" <name: "ident"> <ty: (":" <Type>)?> "=" <val: Expression> "NEWLINE"
        => { let (_, a) = h; Statement::Mut(MutStatement { annotations: a, name, ty, value: Box::new(val) }) },
    // let / mut without assignment — declaration only (type required)
    <h: DeclHead> "let" <name: "ident"> ":" <ty: Type> "NEWLINE"
        => { let (_, a) = h; Statement::LetDecl(LetDeclStatement { annotations: a, name, ty }) },
    <h: DeclHead> "mut" <name: "ident"> ":" <ty: Type> "NEWLINE"
        => { let (_, a) = h; Statement::MutDecl(MutDeclStatement { annotations: a, name, ty }) },
    <h: DeclHead> "const" <cn: ConstNamePath> <ty: (":" <Type>)?> "=" <val: Expression> "NEWLINE"
        => { let (v, a) = h; let (gp, recv, name) = cn; Statement::Const(ConstStatement { visibility: v.unwrap_or_default(), annotations: a, generic_params: gp, receiver: recv, name, ty, value: Box::new(val) }) },
    <h: DeclHead> "using" <path: Path> "NEWLINE"
        => { let (v, a) = h; Statement::Using(UsingStatement { visibility: v.unwrap_or_default(), annotations: a, path }) },
    <h: DeclHead> "type" <path: Path> <gp: GenericParameterList?> "=" <ty: TopLevelType> "NEWLINE"
        => { let (v, a) = h; Statement::TypeAlias(TypeAlias { visibility: v.unwrap_or_default(), annotations: a, name: path, generic_params: gp.unwrap_or_default(), aliased_type: ty }) },
    // namespace (with or without body)
    <h: DeclHead> "namespace" <name: Path> "NEWLINE" "INDENT" <items: Statement*> "DEDENT"
        => { let (v, a) = h; Statement::Namespace(Namespace { visibility: v.unwrap_or_default(), annotations: a, name, items }) },
    <h: DeclHead> "namespace" <name: Path> "NEWLINE"
        => { let (v, a) = h; Statement::Namespace(Namespace { visibility: v.unwrap_or_default(), annotations: a, name, items: vec![] }) },
    // enum / union / struct / interface
    <h: DeclHead> <e: EnumTail>
        => { let (v, a) = h; Statement::Enum(Enum { visibility: v.unwrap_or_default(), annotations: a, ..e }) },
    <h: DeclHead> <u: UnionTail>
        => { let (v, a) = h; Statement::Union(Union { visibility: v.unwrap_or_default(), annotations: a, ..u }) },
    <h: DeclHead> <s: StructTail>
        => { let (v, a) = h; Statement::Struct(Struct { visibility: v.unwrap_or_default(), annotations: a, ..s }) },
    <h: DeclHead> <i: InterfaceTail>
        => { let (v, a) = h; Statement::Interface(Interface { visibility: v.unwrap_or_default(), annotations: a, ..i }) },
    // function (with body) and forward declaration
    <h: DeclHead> <sig: FunctionSignatureBase> "NEWLINE" "INDENT" <wc: WhereClause?> <body: Block> "DEDENT"
        => { let (v, a) = h; let sig = FunctionSignature { visibility: v.unwrap_or_default(), annotations: a, outer_generic_params: merge_where_clause(sig.outer_generic_params, wc.unwrap_or_default()), ..sig }; Statement::Function(Function { signature: sig, body }) },
    <h: DeclHead> <sig: FunctionSignatureBase> "NEWLINE"
        => { let (v, a) = h; let sig = FunctionSignature { visibility: v.unwrap_or_default(), annotations: a, ..sig }; Statement::FunctionDeclaration(FunctionDeclaration { signature: sig }) },
};

// ============================================================================
// Control Flow
// ============================================================================

IfStatement: IfStatement = {
    "if" <cond: Expression> "NEWLINE" "INDENT" <body: Block1> "DEDENT"
    <elifs: ElifClause*>
    <else_body: ("else" "NEWLINE" "INDENT" <Block> "DEDENT")?>
        => IfStatement { condition: Box::new(cond), then_body: body, elif_clauses: elifs, else_body },
};

ElifClause: ElifClause = {
    "elif" <cond: Expression> "NEWLINE" "INDENT" <body: Block1> "DEDENT"
        => ElifClause { condition: Box::new(cond), body },
};

ForStatement: ForStatement = {
    "for" <pattern: "ident"> "in" <iterable: Expression> "NEWLINE" "INDENT" <body: Block1> "DEDENT"
        => ForStatement { pattern, iterable: Box::new(iterable), body },
};

WhileStatement: WhileStatement = {
    "while" <cond: Expression> "NEWLINE" "INDENT" <body: Block1> "DEDENT"
        => WhileStatement { condition: Box::new(cond), body },
};

BlockStatement: BlockStatement = {
    "block" <name: "ident"?> "NEWLINE" "INDENT" <body: Block1> "DEDENT"
        => BlockStatement { name, body },
};

Block: Block = {
    <stmts: Statement*> => Block { statements: stmts },
};

Block1: Block = {
    <stmts: Statement+> => Block { statements: stmts },
};

// ============================================================================
// Enum
// ============================================================================

/// Enum body without visibility/annotations (provided by DeclHead)
EnumTail: Enum = {
    "enum" <repr: EnumRepr?> <path: Path> <gp: GenericParameterList?>
    "NEWLINE" "INDENT"
    <requires: RequiresClause?>
    <wc: WhereClause?>
    <variants: EnumVariantEntry+>
    "DEDENT"
        => Enum {
            visibility: Visibility::default(),
            annotations: vec![],
            name: path,
            representation: repr,
            generic_params: merge_where_clause(gp.unwrap_or_default(), wc.unwrap_or_default()),
            requires: requires.unwrap_or_default(),
            variants,
        },
};

Enum: Enum = {
    <h: DeclHead> <e: EnumTail>
        => { let (v, a) = h; Enum { visibility: v.unwrap_or_default(), annotations: a, ..e } },
};

EnumRepr: Type = {
    "[" <ty: Type> "]" => ty,
};

EnumVariantEntry: EnumVariant = {
    <name: "ident"> "NEWLINE"                             => EnumVariant { name, value: None },
    <name: "ident"> "=" <e: Expression> "NEWLINE"         => EnumVariant { name, value: Some(e) },
};

// ============================================================================
// Union
// ============================================================================

UnionTail: Union = {
    "union" <path: Path>
    <gp: GenericParameterList?>
    "NEWLINE" "INDENT"
    <requires: RequiresClause?>
    <wc: WhereClause?>
    <variants: UnionVariantEntry+>
    "DEDENT"
        => Union {
            visibility: Visibility::default(),
            annotations: vec![],
            name: path,
            generic_params: merge_where_clause(gp.unwrap_or_default(), wc.unwrap_or_default()),
            requires: requires.unwrap_or_default(),
            variants,
        },
};

Union: Union = {
    <h: DeclHead> <u: UnionTail>
        => { let (v, a) = h; Union { visibility: v.unwrap_or_default(), annotations: a, ..u } },
};

UnionVariantEntry: UnionVariant = {
    <name: "ident"> ":" <ty: Type> "NEWLINE" => UnionVariant { name, ty },
};

// ============================================================================
// Struct
// ============================================================================

StructTail: Struct = {
    <packed: "packed"?> "struct" <path: Path> <gp: GenericParameterList?>
    "NEWLINE" "INDENT"
    <requires: RequiresClause?>
    <wc: WhereClause?>
    <fields: StructFieldEntry*>
    "DEDENT"
        => Struct {
            visibility: Visibility::default(),
            annotations: vec![],
            is_packed: packed.is_some(),
            name: path,
            generic_params: merge_where_clause(gp.unwrap_or_default(), wc.unwrap_or_default()),
            requires: requires.unwrap_or_default(),
            fields,
        },
    <packed: "packed"?> "struct" <path: Path> <gp: GenericParameterList?> "NEWLINE"
        => Struct {
            visibility: Visibility::default(),
            annotations: vec![],
            is_packed: packed.is_some(),
            name: path,
            generic_params: gp.unwrap_or_default(),
            requires: vec![],
            fields: vec![],
        },
};

Struct: Struct = {
    <h: DeclHead> <s: StructTail>
        => { let (v, a) = h; Struct { visibility: v.unwrap_or_default(), annotations: a, ..s } },
};

StructFieldEntry: StructField = {
    <h: DeclHead> <name: "ident"> ":" <ty: Type> "NEWLINE" => { let (v, a) = h; StructField { visibility: v.unwrap_or_default(), annotations: a, name, ty } },
};

// ============================================================================
// Function Parsing
// ============================================================================

/// Parses the core function signature (without visibility/annotations, which
/// come from DeclHead).  This rule is shared by both function definitions and
/// forward declarations, so each path is parsed just once.
FunctionSignatureBase: FunctionSignature = {
    <ext: "extern"?> "func" <eff: "!"?>
    <gp: GenericParameterList?>
    <hd: FunctionNamePath>
    "(" <ps: FunctionParams> ")"
    <ret: ReturnTypeSpec?>
        => {
            let (recv, name, fp) = hd;
            let (self_p, params) = ps;
            FunctionSignature {
                visibility: Visibility::default(),
                annotations: vec![],
                is_extern: ext.is_some(),
                is_effect: eff.is_some(),
                receiver: recv,
                name,
                outer_generic_params: gp.unwrap_or_default(),
                func_generic_params: fp,
                self_param: self_p,
                params,
                return_types: ret.unwrap_or_default(),
            }
        },
};

/// Return type specification after `->` in a function signature.
///   Single return value:    `-> T`
///   Multiple return values: `-> (T1, T2, ...)` — parenthesised, two or more types
ReturnTypeSpec: Vec<Type> = {
    "->" "(" <types: Comma<TopLevelType>> ")" => types,
    "->" <ty: TopLevelType> => vec![ty],
};

Function: Function = {
    <h: DeclHead> <sig: FunctionSignatureBase> "NEWLINE" "INDENT" <wc: WhereClause?> <body: Block> "DEDENT"
        => {
            let (v, a) = h;
            let sig = FunctionSignature {
                visibility: v.unwrap_or_default(),
                annotations: a,
                outer_generic_params: merge_where_clause(sig.outer_generic_params, wc.unwrap_or_default()),
                ..sig
            };
            Function { signature: sig, body }
        },
};

FunctionDeclaration: FunctionDeclaration = {
    <h: DeclHead> <sig: FunctionSignatureBase> "NEWLINE"
        => {
            let (v, a) = h;
            let sig = FunctionSignature { visibility: v.unwrap_or_default(), annotations: a, ..sig };
            FunctionDeclaration { signature: sig }
        },
};

/// A unified function path segment.  Parses `ident` or `ident[GenericParameterList]`.
/// Used for ALL positions in `FunctionNamePath`:
///   - Receiver segments (committed by a trailing `::`)
///   - The final function-name segment (whose generic args become `func_generic_params`)
///
/// Conflict analysis
/// -----------------
/// After `PathSegment`, on `[` the parser SHIFTs into `GenericParameterList` (correct for
/// both positions).  On `::` or `(` it REDUCEs to `FunctionPathSeg` with empty args.  The
/// resulting shift/reduce is benign and always resolves correctly:
///   lookahead `::`  → adds this seg to the receiver prefix loop
///   lookahead `(`   → ends `FunctionNamePath`, this seg is the function name
FunctionPathSeg: (String, Vec<GenericParameter>) = {
    <name: PathSegment> <gp: GenericParameterList> => (name, gp),
    <name: PathSegment>                            => (name, vec![]),
};

FunctionNamePath: (Option<Vec<GenericPathSegment>>, String, Vec<GenericParameter>) = {
    // One or more receiver segments each terminated by "::", then the final segment.
    // e.g. `Vec[T]::push`, `ns::HashMap[K,V]::new[U]`, `a::b::c[X]`
    <prefix: (<FunctionPathSeg> "::")+ > <last: FunctionPathSeg>
        => {
            let (name, fp) = last;
            let segs: Vec<GenericPathSegment> = prefix.into_iter()
                .map(|(n, gp)| GenericPathSegment { name: n, generic_args: gp })
                .collect();
            (Some(segs), name, fp)
        },
    // Dot-notation receiver: `recv[T].method`
    <base: FunctionPathSeg> "." <name: PathSegment>
        => {
            let (bname, bgp) = base;
            (Some(vec![GenericPathSegment { name: bname, generic_args: bgp }]), name, vec![])
        },
    // Simple function name with optional func-level generic params
    <last: FunctionPathSeg>
        => { let (name, fp) = last; (None, name, fp) },
};

FunctionParams: (Option<SelfParameter>, Vec<FunctionParameter>) = {
    <sp: SelfParam> "," <params: Comma<FunctionParameter>>
        => (Some(sp), params),
    <sp: SelfParam>
        => (Some(sp), vec![]),
    <params: Comma<FunctionParameter>>
        => (None, params),
};

SelfParam: SelfParameter = {
    "*" "mut" "self" => SelfParameter { is_pointer: true,  is_mutable: true  },
    "*" "self"       => SelfParameter { is_pointer: true,  is_mutable: false },
    "mut" "self"     => SelfParameter { is_pointer: false, is_mutable: true  },
    "self"           => SelfParameter { is_pointer: false, is_mutable: false },
};

FunctionParameter: FunctionParameter = {
    <name: "ident"> ":" <ty: Type> => FunctionParameter { name, ty },
};

// ============================================================================
// Interface Parsing
// ============================================================================

InterfaceTail: Interface = {
    "interface" <path: Path> <gp: GenericParameterList?> "NEWLINE"
        => Interface {
            visibility: Visibility::default(),
            annotations: vec![],
            name: path,
            generic_params: gp.unwrap_or_default(),
            extends: vec![],
            methods: vec![],
        },
    "interface" <path: Path> <gp: GenericParameterList?>
    "NEWLINE" "INDENT"
    <extends: ExtendsClause?>
    <wc: WhereClause?>
    <methods: InterfaceMethod*>
    "DEDENT"
        => Interface {
            visibility: Visibility::default(),
            annotations: vec![],
            name: path,
            generic_params: merge_where_clause(gp.unwrap_or_default(), wc.unwrap_or_default()),
            extends: extends.unwrap_or_default(),
            methods,
        },
};

Interface: Interface = {
    <h: DeclHead> <i: InterfaceTail>
        => { let (v, a) = h; Interface { visibility: v.unwrap_or_default(), annotations: a, ..i } },
};

InterfaceMethod: FunctionSignature = {
    <sig: FunctionSignatureBase> "NEWLINE"
        => sig,
};

// ============================================================================
// Namespace (standalone rule)
// ============================================================================

Namespace: Namespace = {
    <h: DeclHead> "namespace" <name: Path> "NEWLINE" "INDENT" <items: Statement*> "DEDENT"
        => { let (v, a) = h; Namespace { visibility: v.unwrap_or_default(), annotations: a, name, items } },
    <h: DeclHead> "namespace" <name: Path> "NEWLINE"
        => { let (v, a) = h; Namespace { visibility: v.unwrap_or_default(), annotations: a, name, items: vec![] } },
};

// ============================================================================
// Type Alias (standalone rule)
// ============================================================================

TypeAlias: TypeAlias = {
    <h: DeclHead> "type" <path: Path> <gp: GenericParameterList?> "=" <ty: TopLevelType>
        => { let (v, a) = h; TypeAlias { visibility: v.unwrap_or_default(), annotations: a, name: path, generic_params: gp.unwrap_or_default(), aliased_type: ty } },
    <h: DeclHead> "type" <path: Path> <gp: GenericParameterList?> "NEWLINE" "INDENT" <wc: WhereClause> "=" <ty: TopLevelType> "DEDENT"
        => { let (v, a) = h; TypeAlias { visibility: v.unwrap_or_default(), annotations: a, name: path, generic_params: merge_where_clause(gp.unwrap_or_default(), wc), aliased_type: ty } },
};

// ============================================================================
// Helper Rules
// ============================================================================

Comma<T>: Vec<T> = {
    <mut v: (<T> ",")*> <e: T?> => match e {
        None    => v,
        Some(e) => { v.push(e); v }
    }
};

Plus<T>: Vec<T> = {
    <mut v: (<T> "+")*> <e: T> => { v.push(e); v }
};

// ============================================================================
// Extern (token mapping)
// ============================================================================

extern {
    type Location = usize;
    type Error = LexicalError;

    enum Token {
        "INDENT"   => Token::Indent,
        "DEDENT"   => Token::Dedent,
        "NEWLINE"  => Token::Newline,
        "func"      => Token::Func,
        "let"       => Token::Let,
        "mut"       => Token::Mut,
        "const"     => Token::Const,
        "type"      => Token::Type,
        "struct"    => Token::Struct,
        "enum"      => Token::Enum,
        "union"     => Token::Union,
        "interface" => Token::Interface,
        "true"      => Token::True,
        "false"     => Token::False,
        "null"      => Token::Null,
        "self"      => Token::SelfLower,
        "if"        => Token::If,
        "else"      => Token::Else,
        "elif"      => Token::Elif,
        "for"       => Token::For,
        "while"     => Token::While,
        "return"    => Token::Return,
        "in"        => Token::In,
        "where"     => Token::Where,
        "requires"  => Token::Requires,
        "extends"   => Token::Extends,
        "namespace" => Token::Namespace,
        "pass"      => Token::Pass,
        "break"     => Token::Break,
        "continue"  => Token::Continue,
        "block"     => Token::Block,
        "using"     => Token::Using,
        "extern"    => Token::Extern,
        "packed"    => Token::Packed,
        "public"    => Token::Public,
        "export"    => Token::Export,
        "private"   => Token::Private,
        "as"        => Token::As,
        "sizeof"    => Token::Sizeof,
        "alignof"   => Token::Alignof,
        "offsetof"  => Token::Offsetof,
        "u8"    => Token::U8,
        "u16"   => Token::U16,
        "u32"   => Token::U32,
        "u64"   => Token::U64,
        "usize" => Token::USize,
        "isize" => Token::ISize,
        "i8"    => Token::I8,
        "i16"   => Token::I16,
        "i32"   => Token::I32,
        "i64"   => Token::I64,
        "f32"   => Token::F32,
        "f64"   => Token::F64,
        "bool"  => Token::Bool,
        "::" => Token::ColonColon,
        "?"   => Token::Question,
        "+"   => Token::Plus,
        "-"   => Token::Minus,
        "*"   => Token::Star,
        "/"   => Token::Slash,
        "%"   => Token::Percent,
        "=="  => Token::EqEq,
        "!="  => Token::Ne,
        "<"   => Token::Lt,
        ">"   => Token::Gt,
        "<="  => Token::Le,
        ">="  => Token::Ge,
        "&&"  => Token::AndAnd,
        "||"  => Token::OrOr,
        "!"   => Token::Bang,
        "&"   => Token::And,
        "|"   => Token::Or,
        "^"   => Token::Caret,
        "~"   => Token::Tilde,
        "<<" => Token::Shl,
        ">>" => Token::Shr,
        "="   => Token::Eq,
        "+="  => Token::PlusEq,
        "-="  => Token::MinusEq,
        "*="  => Token::StarEq,
        "/="  => Token::SlashEq,
        "%="  => Token::PercentEq,
        "&="  => Token::AndEq,
        "|="  => Token::OrEq,
        "^="  => Token::CaretEq,
        "<<=" => Token::ShlEq,
        ">>=" => Token::ShrEq,
        "->"  => Token::Arrow,
        "=>"  => Token::FatArrow,
        "(" => Token::LParen,
        ")" => Token::RParen,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "[" => Token::LBracket,
        "]" => Token::RBracket,
        ":" => Token::Colon,
        ";" => Token::Semicolon,
        "," => Token::Comma,
        "." => Token::Dot,
        "_" => Token::Underscore,
        "ident"       => Token::Ident(<String>),
        "float"       => Token::FloatLiteral(<FloatLiteral>),
        "int"         => Token::IntegerLiteral(<IntegerLiteral>),
        "string"      => Token::StringLiteral(<String>),
        "char"        => Token::CharLiteral(<String>),
        "interpstring" => Token::InterpolatedStringLiteral(<String>),
        "#" => Token::Hash,
    }
}

